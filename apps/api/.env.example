# Desenvolvimento local (Docker)
DATABASE_URL="postgresql://amococ:amococ_dev@localhost:5432/amococ?schema=public"
API_PORT=3000
# Origens do frontend (dev 5173 + preview do build 4173 p/ `test:deploy`)
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"
# Banco isolado dos testes da API (nunca o banco de desenvolvimento)
TEST_DATABASE_URL="postgresql://amococ:amococ_dev@localhost:5432/amococ_test?schema=public"
# Segredo do JWT (Fase 5: access 15 min + refresh opaco). Produção exige valor
# forte e exclusivo — nunca commitar o real. Dev local pode usar qualquer string.
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
# Teto opcional do rate-limit de login (default 20 tentativas/15 min por IP).
# Testes automatizados usam LOGIN_RATE_LIMIT_MAX baixo.
# LOGIN_RATE_LIMIT_MAX=20
# Produção (Neon) — trocar APENAS o DATABASE_URL:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.aws.neon.tech/neondb?sslmode=require"
